<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Réinitialiser le mot de passe — Portail Services Internes</title>
<style>
:root {
  --bg-primary: #ffffff;
  --bg-secondary: #F4F3F8;
  --border-tertiary: #E3E1EE;
  --border-secondary: #CFCBE2;
  --text-primary: #1F1B3D;
  --text-secondary: #5C5775;
  --text-tertiary: #918CA8;
  --radius-md: 8px;
  --radius-lg: 14px;
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font-sans); color: var(--text-primary); background: var(--bg-secondary); }
.svg-icon { display: inline-flex; align-items: center; justify-content: center; width: 1em; height: 1em; line-height: 0; }
.svg-icon svg { width: 100%; height: 100%; display: block; }

.hero { background: #26215C; padding: 24px 32px; text-align: center; }
.hero-title { font-size: 22px; font-weight: 500; color: white; margin-bottom: 4px; }
.hero-sub { font-size: 13px; color: #CECBF6; }

.wrap { display: flex; justify-content: center; padding: 60px 24px; min-height: calc(100vh - 100px); align-items: flex-start; }
.card {
  background: var(--bg-primary); border: 0.5px solid var(--border-tertiary);
  border-radius: var(--radius-lg); width: 420px; max-width: 100%; padding: 32px;
}

.card-title { font-size: 16px; font-weight: 500; margin-bottom: 4px; text-align: center; }
.card-sub { font-size: 12px; color: var(--text-secondary); text-align: center; margin-bottom: 24px; }

.field { margin-bottom: 16px; }
.field-label { font-size: 12px; color: var(--text-secondary); margin-bottom: 5px; display: block; }
.field-input-wrap { position: relative; }
.field-icon { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); font-size: 16px; color: var(--text-tertiary); }
.field-input {
  width: 100%; padding: 9px 12px 9px 34px; border: 0.5px solid var(--border-secondary);
  border-radius: var(--radius-md); font-size: 13px; font-family: inherit;
  background: var(--bg-primary); color: var(--text-primary);
}
.field-input:focus { outline: none; border-color: #7F77DD; }
.field-error { font-size: 11px; color: #A32D2D; margin-top: 4px; display: none; }

.strength-bar { display: flex; gap: 4px; margin-top: 6px; }
.strength-seg { height: 3px; flex: 1; border-radius: 2px; background: var(--bg-secondary); }
.strength-seg.on-weak { background: #E24B4A; }
.strength-seg.on-mid { background: #EF9F27; }
.strength-seg.on-strong { background: #1D9E75; }

.btn-primary {
  width: 100%; background: #1D9E75; color: white; border: none; border-radius: var(--radius-md);
  padding: 10px; font-size: 13px; font-weight: 500; cursor: pointer; font-family: inherit;
}
.btn-primary:hover { background: #0F6E56; }
.btn-primary:disabled { background: var(--bg-secondary); color: var(--text-tertiary); cursor: not-allowed; }

.btn-link {
  display: inline-block; margin-top: 16px; text-align: center; width: 100%;
  font-size: 12px; color: #534AB7; text-decoration: none;
}
.btn-link:hover { text-decoration: underline; }

.api-error-banner {
  background: #FCEBEB; color: #A32D2D; border-radius: var(--radius-md);
  padding: 10px 14px; font-size: 12.5px; margin-bottom: 16px; display: none;
}

.state-icon {
  width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center;
  justify-content: center; margin: 0 auto 18px; font-size: 26px;
}
.state-icon.success { background: #EAF3DE; color: #3B6D11; }
.state-icon.error { background: #FCEBEB; color: #A32D2D; }
.state-title { font-size: 17px; font-weight: 500; margin-bottom: 8px; text-align: center; }
.state-text { font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 22px; text-align: center; }

.view { display: none; }
.view.active { display: block; }
</style>
</head>
<body>

<div class="hero">
  <div class="hero-title">Services internes</div>
  <div class="hero-sub">La plateforme de services pour les agents</div>
</div>

<div class="wrap">
  <div class="card">

    <div class="view active" id="view-form">
      <div class="card-title">Réinitialiser le mot de passe</div>
      <div class="card-sub">Choisissez un nouveau mot de passe pour votre compte</div>

      <div class="api-error-banner" id="api-error-banner"></div>

      <div class="field">
        <label class="field-label">Nouveau mot de passe</label>
        <div class="field-input-wrap">
          <span class="svg-icon field-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V7a4 4 0 018 0v4"/></svg></span>
          <input class="field-input" type="password" id="new-pass" placeholder="8 caractères minimum" oninput="checkStrength()"/>
        </div>
        <div class="strength-bar">
          <div class="strength-seg" id="seg-1"></div>
          <div class="strength-seg" id="seg-2"></div>
          <div class="strength-seg" id="seg-3"></div>
        </div>
        <div class="field-error" id="err-new-pass">Le mot de passe doit contenir au moins 8 caractères.</div>
      </div>

      <div class="field">
        <label class="field-label">Confirmer le nouveau mot de passe</label>
        <div class="field-input-wrap">
          <span class="svg-icon field-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="1"/><path d="M8 11V7a4 4 0 018 0v4"/></svg></span>
          <input class="field-input" type="password" id="confirm-pass" placeholder="••••••••"/>
        </div>
        <div class="field-error" id="err-confirm-pass">Les mots de passe ne correspondent pas.</div>
      </div>

      <button class="btn-primary" id="btn-reset-submit" onclick="trySubmitReset()">Réinitialiser le mot de passe</button>
    </div>

    <div class="view" id="view-success">
      <div class="state-icon success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M5 12l5 5 9-10"/></svg>
      </div>
      <div class="state-title">Mot de passe modifié</div>
      <div class="state-text">Votre mot de passe a été mis à jour avec succès. Vous pouvez maintenant vous connecter avec votre nouveau mot de passe.</div>
      <a class="btn-primary" href="/" style="text-decoration:none; display:block; text-align:center;">Aller à la connexion</a>
    </div>

    <div class="view" id="view-invalid-token">
      <div class="state-icon error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </div>
      <div class="state-title">Lien invalide</div>
      <div class="state-text">Aucun jeton de réinitialisation n'a été trouvé dans ce lien. Vérifiez que vous avez bien copié l'adresse complète depuis l'e-mail reçu.</div>
      <a class="btn-link" href="/">Retour à la connexion</a>
    </div>

  </div>
</div>

<script>
function showView(name){
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-' + name).classList.add('active');
}

function getTokenFromUrl(){
  return new URLSearchParams(window.location.search).get('token');
}

function checkStrength(){
  const v = document.getElementById('new-pass').value;
  const segs = [document.getElementById('seg-1'), document.getElementById('seg-2'), document.getElementById('seg-3')];
  segs.forEach(s => s.className = 'strength-seg');
  let score = 0;
  if(v.length >= 8) score++;
  if(/[A-Z]/.test(v) && /[0-9]/.test(v)) score++;
  if(v.length >= 12 && /[^A-Za-z0-9]/.test(v)) score++;
  const cls = score <= 1 ? 'on-weak' : score === 2 ? 'on-mid' : 'on-strong';
  for(let i = 0; i < Math.max(score,1) && i < 3; i++){ segs[i].classList.add(cls); }
}

function showApiError(message){
  const banner = document.getElementById('api-error-banner');
  banner.textContent = message;
  banner.style.display = 'block';
}

function clearApiError(){
  document.getElementById('api-error-banner').style.display = 'none';
}

async function trySubmitReset(){
  const token = getTokenFromUrl();
  const pass = document.getElementById('new-pass').value;
  const confirmPass = document.getElementById('confirm-pass').value;
  const errPass = document.getElementById('err-new-pass');
  const errConfirm = document.getElementById('err-confirm-pass');
  const btn = document.getElementById('btn-reset-submit');

  let ok = true;
  if(pass.length < 8){ errPass.style.display = 'block'; ok = false; } else { errPass.style.display = 'none'; }
  if(pass !== confirmPass || !confirmPass){ errConfirm.style.display = 'block'; ok = false; } else { errConfirm.style.display = 'none'; }
  if(!ok) return;

  clearApiError();
  btn.disabled = true;
  btn.textContent = 'Réinitialisation en cours...';

  try {
    const response = await fetch('/api/auth/reset-password', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token, password: pass }),
    });
    const body = await response.json().catch(() => null);

    if(!response.ok){
      throw new Error((body && body.error) || 'Une erreur est survenue, veuillez réessayer.');
    }

    showView('success');
  } catch (err) {
    showApiError(err.message);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Réinitialiser le mot de passe';
  }
}

// Au chargement : si aucun token n'est présent dans l'URL, inutile d'afficher
// le formulaire — on informe directement l'agent que le lien est invalide.
(function init(){
  if(!getTokenFromUrl()){
    showView('invalid-token');
  }
})();
</script>
</body>
</html>
